# ─── Server ───────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 5000)
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/jobjournal
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/jobjournal
MONGO_URI=mongodb://127.0.0.1:27017/jobjournal

# ─── Authentication ───────────────────────────────────────────────────────────
# Long, random secret used to sign JWT tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ─── Email (Nodemailer / Gmail) ───────────────────────────────────────────────
# Gmail address used to send welcome emails, daily reminders, and reports.
EMAIL_USER=your_gmail_address@gmail.com

# Gmail App Password (NOT your regular Gmail password).
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your_gmail_app_password
